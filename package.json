{
  "name": "deaddrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 18904",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 18904",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test experiments/qualification/pilot/*.test.ts experiments/qualification/pilot/hosting/*.test.ts experiments/qualification/pilot/web/publish-snapshot.test.ts experiments/qualification/transport/*.test.ts",
    "test:contracts": "forge test --root experiments/qualification/contracts",
    "test:proofs": "go -C experiments/qualification/prover test -count=1 ./...",
    "check": "npm run typecheck && npm test && npm run test:contracts && npm run test:proofs && npm run build",
    "test:browser": "node scripts/test-demo.mjs",
    "preflight": "node experiments/qualification/pilot/preflight.mjs",
    "build:hosting": "node scripts/build-hosting.mjs",
    "pilot:start": "node --import tsx experiments/qualification/pilot/start.mjs",
    "pilot:test": "node --import tsx experiments/qualification/pilot/browser-test.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@openzeppelin/contracts": "5.6.1",
    "@vercel/blob": "2.7.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
