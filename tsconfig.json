{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "experiments/qualification/pilot/**/*.ts",
    "experiments/qualification/transport/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".worktrees",
    ".runtime"
  ]
}
